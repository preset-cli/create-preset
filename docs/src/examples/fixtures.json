  "monorepo": {
    "repo": "https://github.com/example/product.git",
    "sourceFiles": {
      "apps/docs/src/page.ts": "import { Button } from '@example/ui'\n\nexport const action = Button({ label: 'Get started' })\n",
      "apps/docs/package.json": "{\n  \"name\": \"docs-starter\",\n  \"version\": \"1.0.0\",\n  \"private\": true,\n  \"dependencies\": {\n    \"@example/ui\": \"workspace:*\"\n  }\n}\n",
      "apps/docs/src/__tests__/page.test.ts": "// Tests used while maintaining this starter.\n",
      "packages/ui/package.json": "{\n  \"name\": \"@example/ui\",\n  \"version\": \"1.2.3\"\n}\n",
      "pnpm-workspace.yaml": "packages:\n  - apps/*\n  - packages/*\n"
    },
    "presets": [
      {
        "id": "docs",
        "label": {
          "zh": "独立文档项目",
          "en": "Standalone docs"
        },
        "target": "my-docs",
        "config": {
          "$schema": "https://preset.js.org/schema/preset.schema.json",
          "version": 1,
          "source": {
            "repo": "https://github.com/example/product.git",
            "directory": "apps/docs"
          },
          "exclude": [
            "src/__tests__"
          ],
          "packageJson": {
            "resolveWorkspace": true,
            "workspaceVersions": {
              "@example/ui": "1.2.3"
            }
          }
        },
        "outputFiles": {
          "src/page.ts": "import { Button } from '@example/ui'\n\nexport const action = Button({ label: 'Get started' })\n",
          "package.json": "{\n  \"name\": \"my-docs\",\n  \"version\": \"1.0.0\",\n  \"private\": true,\n  \"dependencies\": {\n    \"@example/ui\": \"1.2.3\"\n  }\n}\n"
        }
      }
    ]
  },
  "file-changes": {
    "repo": "https://github.com/example/service-starter.git",
    "sourceFiles": {
      "index.js": "console.log('Service ready')\n",
      "demo.js": "console.log('Sample data')\n",
      "README.md": "# Service starter\n\nA template with sample data.\n",
      ".env.example": "APP_LABEL=Starter\n",
      "package.json": "{\n  \"name\": \"service-starter\",\n  \"version\": \"1.0.0\",\n  \"private\": true,\n  \"scripts\": {\n    \"start\": \"node index.js\",\n    \"demo\": \"node demo.js\"\n  }\n}\n"
    },
    "presets": [
      {
        "id": "service",
        "label": {
          "zh": "团队服务",
          "en": "Team service"
        },
        "target": "my-service",
        "config": {
          "$schema": "https://preset.js.org/schema/preset.schema.json",
          "version": 1,
          "source": {
            "repo": "https://github.com/example/service-starter.git",
            "directory": ""
          },
          "exclude": [
            "demo.js"
          ],
          "write": [
            {
              "path": "README.md",
              "lines": [
                "# Team service",
                "",
                "Run `npm start` to start the service."
              ]
            }
          ],
          "replace": [
            {
              "path": ".env.example",
              "from": "APP_LABEL=Starter",
              "to": "APP_LABEL=Team"
            }
          ],
          "json": [
            {
              "path": "package.json",
              "value": {
                "scripts": {
                  "demo": null
                }
              }
            }
          ]
        },
        "outputFiles": {
          "index.js": "console.log('Service ready')\n",
          "README.md": "# Team service\n\nRun `npm start` to start the service.\n",
          ".env.example": "APP_LABEL=Team\n",
          "package.json": "{\n  \"name\": \"my-service\",\n  \"version\": \"1.0.0\",\n  \"private\": true,\n  \"scripts\": {\n    \"start\": \"node index.js\"\n  }\n}\n"
        }
      }
    ]
  }
